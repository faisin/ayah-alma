[Unit]
Description=AYAH ALMA Panel
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/ayah-alma/website
EnvironmentFile=/opt/ayah-alma/website/.env
ExecStart=/usr/bin/python3 -m gunicorn --bind 127.0.0.1:5000 --workers 1 app:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
