#!/bin/bash
# Menu VMess - by Ayah Alma

GREEN='\e[1;32m'
YELLOW='\e[1;33m'
CYAN='\e[1;36m'
RED='\e[1;31m'
NC='\e[0m'

clear
echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${CYAN}              ⚙️ MENU VMESS XRAY              ${NC}"
echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}[1]${NC} ${CYAN}Tambah Akun VMess Ayah Alma${NC}"
echo -e "${GREEN}[2]${NC} ${CYAN}Trial Akun VMess Ayah Alma${NC}"
echo -e "${GREEN}[3]${NC} ${CYAN}Hapus Akun VMess Ayah Alma${NC}"
echo -e "${GREEN}[4]${NC} ${CYAN}Cek Login VMess Ayah Alma${NC}"
echo -e "${GREEN}[5]${NC} ${CYAN}Perpanjang Masa Aktif Akun Vmess${NC}"
echo -e "${GREEN}[x]${NC} ${RED}Kembali ke menu utama Ayah Alma${NC}"
echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

read -p "👉 Pilih opsi: " opt

case $opt in
1)
bash /etc/ayah-alma/xray/add-vmess.sh
;;

2)
bash /etc/ayah-alma/xray/trial-vmess.sh
;;

3)
bash /etc/ayah-alma/xray/del-vmess.sh
;;

4)
bash /etc/ayah-alma/xray/cek-vmess.sh
;;

5)
bash /etc/ayah-alma/xray/renew-vmess.sh
;;

x|X)
/usr/bin/menu 2>/dev/null || menu
exit 0
;;

*)
echo "❌ Pilihan salah!"
sleep 1
/usr/bin/m-vmess 2>/dev/null || bash /etc/ayah-alma/xray/m-vmess
;;
esac
