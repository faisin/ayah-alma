#!/usr/bin/env bash
# Compatibility alias: main menu calls m-ss; implementation is m-ssws.
if command -v m-ssws >/dev/null 2>&1; then
    exec m-ssws "$@"
fi
if [[ -x /usr/bin/m-ssws ]]; then
    exec /usr/bin/m-ssws "$@"
fi
if [[ -x /etc/ayah-alma/xray/m-ssws ]]; then
    exec bash /etc/ayah-alma/xray/m-ssws "$@"
fi
printf 'ERROR: menu Shadowsocks (m-ssws) tidak ditemukan.\n' >&2
exit 127
