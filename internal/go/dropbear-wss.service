[Unit]
Description=AYAH ALMA SSH WSS payload bridge (Dropbear 143; TLS terminated by HAProxy)
After=network.target dropbear.service haproxy.service
Wants=dropbear.service

[Service]
Type=simple
ExecStart=/usr/local/bin/dropbearwss
Restart=always
RestartSec=2
LimitNOFILE=100000

[Install]
WantedBy=multi-user.target
